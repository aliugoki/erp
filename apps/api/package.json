{
  "name": "@app/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "test:e2e": "bash test/auth-e2e.sh && bash test/rbac-e2e.sh && bash test/tenant-isolation-e2e.sh && bash test/audit-service-auth-e2e.sh && bash test/features-e2e.sh && bash test/hr-e2e.sh && bash test/finance-e2e.sh && bash test/finance-accounting-e2e.sh && bash test/inventory-e2e.sh && bash test/crm-e2e.sh && bash test/pos-e2e.sh && bash test/production-e2e.sh && bash test/assets-e2e.sh && bash test/projects-e2e.sh && bash test/consumers-e2e.sh && bash test/notifications-e2e.sh && bash test/reports-e2e.sh && bash test/realtime-e2e.sh && bash test/ml-bridge-e2e.sh && bash test/resilience-e2e.sh && bash test/idempotency-e2e.sh && bash test/orders-e2e.sh && bash test/overload-e2e.sh && bash test/tracing-e2e.sh && bash test/security-e2e.sh",
    "test:chaos": "bash test/chaos-e2e.sh",
    "test:metrics": "bash test/metrics-e2e.sh",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@metaxperts/config": "workspace:*",
    "@metaxperts/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.3.0",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.15",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "amqplib": "^0.10.5",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.1.0",
    "nodemailer": "^6.9.16",
    "otplib": "^13.4.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.20"
