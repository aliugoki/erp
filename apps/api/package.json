    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "jsonwebtoken": "^9.0.2",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
