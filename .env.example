# MetaXperts ERP — environment template.
# Copy to .env and fill in real values. NEVER commit a real .env (see .gitignore).
# All values below are non-secret placeholders.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
WEB_PORT=3001
ML_PORT=8000
WORKER_PORT=3002

# ── Database (Postgres 16 via PgBouncer) ──────────────────────────────────
# The API connects THROUGH PgBouncer (transaction pool mode), not directly to Postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=metaxperts
POSTGRES_USER=metaxperts
POSTGRES_PASSWORD=replace_me
# PgBouncer (what apps actually point at)
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432
DATABASE_URL=postgresql://metaxperts:replace_me@localhost:6432/metaxperts

# ── Redis (cache, BullMQ queues, refresh-token store) ─────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ── RabbitMQ (event broker) ───────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=metaxperts
RABBITMQ_PASSWORD=replace_me
RABBITMQ_URL=amqp://metaxperts:replace_me@localhost:5672

# ── Auth / JWT (rotating refresh tokens) ──────────────────────────────────
# Generate strong unique values per environment, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_REFRESH_TTL=7d

# ── Service-to-service auth (API ↔ ML, API ↔ worker) ──────────────────────
# Signed short-lived service token; ML/internal endpoints reject calls without it.
SERVICE_AUTH_SECRET=replace_me_with_a_long_random_string
SERVICE_AUTH_TTL=300s

# ── Observability (OpenTelemetry) ─────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=metaxperts-api
LOG_LEVEL=info

# ── Object storage (MinIO / S3) ───────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=metaxperts
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me
S3_FORCE_PATH_STYLE=true

# ── Notifications (Phase 5.1) ─────────────────────────────────────────────
# NOTIFICATIONS_ENABLED registers the consumer that turns domain events into in-app notifications
# (e.g. crm.deal_closed → the assignee). Off by default (e.g. in tests).
NOTIFICATIONS_ENABLED=false
# Email is a best-effort side-channel retried via a BullMQ queue. Off by default → in-app only, so a
# missing/down SMTP server never blocks the durable in-app notification.
NOTIFICATIONS_EMAIL_ENABLED=false
# SMTP — works against MailHog/Mailpit locally (open-source). Port 1025 = MailHog default.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MetaXperts ERP <no-reply@metaxperts.local>

# ── Outbox relay (Phase 4) ────────────────────────────────────────────────
# The relay publishes outbox events to the broker. It connects via MIGRATION_DATABASE_URL (owner,
# bypasses RLS to see all tenants). Disabled by default; enable in the process that should relay.
OUTBOX_RELAY_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=100

# ── Reporting (Phase 5.2) ─────────────────────────────────────────────────
# Periodically recompute the per-tenant reporting read models. Off by default (tests/dev refresh on
# demand via POST /reports/refresh). Enable in one process in production.
REPORTING_REFRESH_ENABLED=false
REPORTING_REFRESH_INTERVAL_MS=60000

# ── ML service (Phase 6) ──────────────────────────────────────────────────
# The ML service (apps/ml) is a trusted backend: it reads stock movements + writes forecasts with a
# privileged Postgres URL (falls back to DATABASE_URL) and scopes by explicit tenant_id. Auth to ML is
# the same signed x-service-token as the API's internal routes (SERVICE_AUTH_SECRET, ADR-006).
ML_DATABASE_URL=postgresql://metaxperts:replace_me@localhost:55432/metaxperts
FORECAST_MIN_POINTS=8
FORECAST_DEFAULT_HORIZON=14

# ── Money defaults (ADR-007) ──────────────────────────────────────────────
DEFAULT_CURRENCY=PKR
